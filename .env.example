# OpenAI image API configuration.
# Do not commit real API keys.
# Leave OPENAI_BASE_URL empty to use the official OpenAI API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_MS=1200000

# Volcengine Ark / Seedance video generation.
# Do not commit real API keys.
ARK_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
# Leave empty to use https://ark.cn-beijing.volces.com/api/v3.
ARK_BASE_URL=

# Server/runtime.
PORT=8787
PUBLIC_PORT=8787
DEV_PUBLIC_PORT=8790
BLUE_PORT=8788
GREEN_PORT=8789
HOST=127.0.0.1
DATA_DIR=./data

# Browser extension release and packaging.
# Admin settings saved in the database can override these runtime defaults.
EXTENSION_DEV_API_BASE_URL=https://dev.neimou.com
EXTENSION_PROD_API_BASE_URL=https://ai.neimou.com
EXTENSION_DEV_NAME=商图AI助手 Dev
EXTENSION_PROD_NAME=商图AI助手
EXTENSION_DEV_VERSION=
EXTENSION_PROD_VERSION=
EXTENSION_DEV_DOWNLOAD_URL=
EXTENSION_PROD_DOWNLOAD_URL=
EXTENSION_DEV_LATEST_DOWNLOAD_URL=
EXTENSION_PROD_LATEST_DOWNLOAD_URL=
EXTENSION_DEV_INSTALL_HELP_URL=/install-help.html
EXTENSION_PROD_INSTALL_HELP_URL=/install-help.html

# Mobile app release defaults.
# Admin settings saved in the database can override these runtime defaults.
APP_RELEASE_IOS_VERSION=
APP_RELEASE_IOS_BUILD_NUMBER=
APP_RELEASE_IOS_DOWNLOAD_URL=
APP_RELEASE_ANDROID_VERSION=
APP_RELEASE_ANDROID_BUILD_NUMBER=
APP_RELEASE_ANDROID_DOWNLOAD_URL=

# User authentication.
# PC and extension clients should call /api/auth/login or /api/auth/register,
# then send Authorization: Bearer <JWT>.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# SMTP email verification.
# You can also configure these in the admin panel; saved admin settings take precedence.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=商图 AI 助手
SMTP_FROM_EMAIL=

# Aliyun SMS verification.
# You can also configure these in the admin panel; saved admin settings take precedence.
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_BIND_TEMPLATE_CODE=

# Push and task-complete notifications.
# Client apps only need the public Getui AppID. Keep AppKey/MasterSecret on the API server.
GETUI_ENABLED=false
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=
GETUI_BASE_URL=https://restapi.getui.com/v2

# APNs push for iOS app notifications.
APNS_ENABLED=false
APNS_BUNDLE_ID=com.neimou.shangtuai
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_KEY_FILE=
APNS_ENVIRONMENT=production

# WeChat mini program subscribe-message template for task completion.
WECHAT_MINIAPP_ENABLED=false
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_MINIAPP_TASK_COMPLETE_TEMPLATE_ID=

# Apple In-App Purchase server verification
APPLE_IAP_BUNDLE_ID=com.neimou.shangtuai
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRODUCT_PREFIX=com.neimou.shangtuai.plan.
# Optional explicit plan-to-product mapping, e.g. {"starter":"com.neimou.shangtuai.plan.starter","pro":"com.neimou.shangtuai.plan.pro"}
APPLE_IAP_PRODUCT_IDS_JSON=

# Development-only fallback that re-enables the old demo x-user-id/x-workspace-id tenant.
# Keep false in shared/staging/production environments.
ALLOW_DEMO_AUTH=false

# MySQL storage.
# Use DATABASE_URL or the MYSQL_* fields below. Docker Compose defaults match these values.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gpt_image_canvas
MYSQL_PASSWORD=gpt_image_canvas
MYSQL_DATABASE=gpt_image_canvas
MYSQL_ROOT_PASSWORD=root

# Optional cloud asset storage.
# The app stores generated images locally by default. You can either configure cloud
# storage from the admin backend or set these environment variables directly.
# If the database has no enabled cloud config, the API will fall back to these env values.
# Secrets saved from the admin UI are stored in system settings and are never returned in
# full by the settings API.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_DEFAULT_BUCKET=
OSS_DEFAULT_REGION=oss-cn-hangzhou
OSS_DEFAULT_KEY_PREFIX=gpt-image-canvas/assets
COS_SECRET_ID=
COS_SECRET_KEY=
COS_DEFAULT_BUCKET=source-1253253332
COS_DEFAULT_REGION=ap-nanjing
COS_DEFAULT_KEY_PREFIX=gpt-image-canvas/assets
# Optional CDN base URL for generated assets uploaded to cloud storage.
# When set, API responses include asset.cdnUrl and, for OSS assets, thumbnail URLs
# using x-oss-process image resize parameters.
ASSET_CDN_BASE_URL=
