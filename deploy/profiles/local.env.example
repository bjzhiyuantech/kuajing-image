# 商图 AI 单机版配置模板。
# 桌面应用会提供界面版配置；手动部署时复制为 .env 后只需填写模型密钥。

# 生图模型。
OPENAI_API_KEY=
# 留空使用官方 OpenAI；如使用兼容服务，填写类似 https://example.com/v1。
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_MS=1200000

# 本机服务。
DEPLOYMENT_PROFILE=local
DEPLOYMENT_PROFILE_NAME=商图 AI 单机版
DEPLOYMENT_TARGET=desktop
HOST=127.0.0.1
PORT=8787
PUBLIC_PORT=8787
DATA_DIR=./data

# 本地浏览器插件。
EXTENSION_LOCAL_API_BASE_URL=http://127.0.0.1:8787
EXTENSION_LOCAL_DOWNLOAD_URL=/downloads/kuajing-image-extension-local-latest.zip
EXTENSION_LOCAL_LATEST_DOWNLOAD_URL=/downloads/kuajing-image-extension-local-latest.zip
EXTENSION_LOCAL_INSTALL_HELP_URL=/install-help.html

# Docker 镜像。
APP_IMAGE=kuajing-image/app:local
MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:8.4
NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.27-alpine

# 单机免登录。桌面应用会自动生成 JWT_SECRET。
ALLOW_DEMO_AUTH=true
JWT_SECRET=

# 内置 MySQL。桌面应用会自动维护这些值。
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gpt_image_canvas
MYSQL_PASSWORD=gpt_image_canvas
MYSQL_DATABASE=gpt_image_canvas
MYSQL_ROOT_PASSWORD=root
