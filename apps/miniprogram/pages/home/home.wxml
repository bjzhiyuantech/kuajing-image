<view class="home-page">
  <view class="home-top">
    <view>
      <view class="brand-line">商图AI</view>
      <view class="hero-title">电商AI图片助手</view>
      <view class="hero-copy">上传产品图，批量生成主图、翻译图、去水印图和平台场景图。</view>
    </view>
    <view class="avatar" bindtap="goProfile">{{userInitial}}</view>
  </view>

  <view class="hero-card">
    <view class="hero-glow"></view>
    <view class="hero-content">
      <view class="hero-kicker">AI PRODUCT IMAGE SUITE</view>
      <view class="hero-heading">一张产品图，生成整套电商素材</view>
      <view class="hero-sub">适合上新、铺货、本地化翻译、清理旧水印和多平台投放。</view>
      <view class="hero-actions">
        <button class="start-button" bindtap="goCreate">开始出图</button>
        <view class="ghost-button" bindtap="goJobs">查看任务</view>
      </view>
    </view>
    <view class="mock-stack">
      <view class="mock-card mock-main">
        <view class="mock-image"></view>
        <view class="mock-line wide"></view>
        <view class="mock-line"></view>
      </view>
      <view class="mock-card mock-float">
        <view class="spark"></view>
        <view>
          <view class="mock-mini-line"></view>
          <view class="mock-mini-line short"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <view class="section-title">常用功能</view>
      <view class="section-more" bindtap="goCreate">全部</view>
    </view>
    <view class="feature-grid">
      <view wx:for="{{features}}" wx:key="key" class="feature-item" bindtap="openFeature" data-key="{{item.key}}">
        <view class="feature-icon {{item.key}}">{{item.icon}}</view>
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <view class="section-title">推荐工作流</view>
      <view class="section-more" bindtap="goCustomCreate">自定义</view>
    </view>
    <scroll-view scroll-x class="workflow-scroll">
      <view wx:for="{{workflows}}" wx:key="key" class="workflow-card" bindtap="openWorkflow" data-key="{{item.key}}">
        <view class="workflow-top">
          <view class="workflow-badge">{{item.badge}}</view>
          <view class="workflow-count">{{item.count}}</view>
        </view>
        <view class="workflow-title">{{item.title}}</view>
        <view class="workflow-desc">{{item.desc}}</view>
        <view class="workflow-tags">
          <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <view class="section-title">最近任务</view>
      <view class="section-more" bindtap="goJobs">更多</view>
    </view>
    <view wx:if="{{recentJobs.length}}" class="recent-list">
      <view wx:for="{{recentJobs}}" wx:key="jobId" class="recent-item" bindtap="goJobs">
        <view>
          <view class="recent-title">{{item.productTitle}}</view>
          <view class="recent-meta">{{item.completedScenes}}/{{item.totalScenes}} 场景 · {{item.updatedAt}}</view>
        </view>
        <view class="recent-status {{item.status}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view wx:else class="empty-task">
      <view class="empty-title">还没有任务</view>
      <view class="empty-copy">选择一个工作流，上传产品图开始生成。</view>
    </view>
  </view>

  <view class="section-block">
    <view class="section-head">
      <view class="section-title">公开作品</view>
      <view class="section-more" bindtap="goPublicGallery">查看更多</view>
    </view>
    <view class="public-works-card">
      <view class="public-works-head">
        <view>
          <view class="public-works-title">平台精选案例</view>
          <view class="public-works-copy">看看公开展示的成品效果，找找适合你商品的构图和风格。</view>
        </view>
        <view class="public-works-badge">所有用户可见</view>
      </view>
      <view wx:if="{{publicWorksLoading && !publicWorks.length}}" class="public-works-loading">正在加载公开作品</view>
      <scroll-view wx:elif="{{publicWorks.length}}" scroll-x class="public-works-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{publicWorks}}" wx:key="imageId" class="public-work-item" bindtap="openPublicWork" data-id="{{item.imageId}}">
          <image class="public-work-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="public-work-body">
            <view class="public-work-prompt">{{item.promptText}}</view>
            <view class="public-work-meta">
              <text>{{item.tagText}}</text>
              <text>放大</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="public-works-empty">
        <view class="empty-title">{{publicWorksError ? '公开作品加载失败' : '暂无公开作品'}}</view>
        <view class="empty-copy">{{publicWorksError || '后台开启公开展示后，这里会展示平台精选作品。'}}</view>
      </view>
    </view>
  </view>

  <view class="member-strip" bindtap="goProfile">
    <view>
      <view class="member-title">{{memberTitle}}</view>
      <view class="member-copy">{{memberCopy}}</view>
    </view>
    <view class="member-arrow">›</view>
  </view>

  <view class="quick-custom-fab" bindtap="openQuickCustom">
    <view class="quick-custom-fab-icon">✦</view>
    <view class="quick-custom-fab-text">自由生成</view>
  </view>

  <view wx:if="{{quickCustomVisible}}" class="quick-custom-mask" catchtap="closeQuickCustom">
    <view class="quick-custom-sheet" catchtap="noop">
      <view class="quick-custom-head">
        <view>
          <view class="quick-custom-title">自由生成</view>
          <view class="quick-custom-sub">写提示词，可选参考图，直接生成 1 张图。</view>
        </view>
        <view class="quick-custom-close" bindtap="closeQuickCustom">×</view>
      </view>

      <scroll-view scroll-y class="quick-custom-scroll" enhanced show-scrollbar="{{false}}">
        <view class="quick-custom-composer">
          <view class="quick-custom-image-rail">
            <view wx:for="{{quickCustomImages}}" wx:key="path" class="quick-custom-image-wrap">
              <image class="quick-custom-image" src="{{item.path}}" mode="aspectFill" />
              <view class="quick-custom-remove" bindtap="removeQuickCustomImage" data-index="{{index}}">×</view>
            </view>
            <view wx:if="{{quickCustomImages.length < quickCustomImageLimit}}" class="quick-custom-add-image" bindtap="chooseQuickCustomImages">
              <view class="quick-custom-add-plus">+</view>
              <view>拍照 / 相册</view>
            </view>
          </view>
          <textarea
            class="quick-custom-input"
            maxlength="-1"
            value="{{quickCustomPrompt}}"
            bindinput="onQuickCustomPromptInput"
            placeholder="描述你想生成的画面，例如：白色防晒衣，夏季户外通勤，真实摄影，干净高级，留白。"
            placeholder-class="quick-custom-placeholder"
          />
          <view class="quick-custom-composer-foot">
            <view class="quick-custom-tool {{(!quickCustomPrompt || quickCustomOptimizing || quickCustomSubmitting) ? 'disabled' : ''}}" bindtap="optimizeQuickCustomPrompt">
              <view class="quick-custom-tool-icon">✦</view>
              <view>{{quickCustomOptimizing ? '优化中' : '优化提示词'}}</view>
            </view>
            <view class="quick-custom-count">{{quickCustomImages.length}}/{{quickCustomImageLimit}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="quick-custom-submit-row">
        <view class="quick-custom-cost">
          <view class="quick-custom-cost-value">1 张</view>
          <view class="quick-custom-cost-label">生成结果</view>
        </view>
        <button
          class="quick-custom-submit {{(!quickCustomPrompt || quickCustomSubmitting) ? 'disabled' : ''}}"
          loading="{{quickCustomSubmitting}}"
          bindtap="submitQuickCustom"
        >
          Generate
        </button>
      </view>
    </view>
  </view>
</view>
