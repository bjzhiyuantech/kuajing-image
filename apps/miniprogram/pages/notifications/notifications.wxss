.page {
  min-height: 100vh;
  padding: 28rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #101828;
  color: #ffffff;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.page-copy {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.read-button {
  height: 64rpx;
  margin: 0;
  border-radius: 32rpx;
  background: #ffffff;
  color: #155eef;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
  padding: 0 22rpx;
}

.read-button[disabled] {
  opacity: 0.45;
}

.empty-card {
  padding: 56rpx 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  color: #101828;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
}

.message-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.message-card.unread {
  border-color: rgba(21, 94, 239, 0.22);
  background: #eff6ff;
}

.message-dot {
  width: 18rpx;
  height: 18rpx;
  flex: none;
  border-radius: 999rpx;
  background: #155eef;
}

.message-dot.success {
  background: #12b76a;
}

.message-dot.warning {
  background: #f79009;
}

.message-dot.error {
  background: #f04438;
}

.message-copy {
  flex: 1;
  min-width: 0;
}

.message-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
}

.message-body {
  margin-top: 8rpx;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.45;
}

.message-time {
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
  font-weight: 700;
}

.message-arrow {
  color: #98a2b3;
  font-size: 42rpx;
  font-weight: 300;
}
