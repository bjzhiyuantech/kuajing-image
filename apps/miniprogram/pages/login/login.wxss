.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 0 40rpx;
  background: #f5f7ff;
}

.brand-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 188rpx 32rpx 104rpx;
}

.brand-logo {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 146rpx;
  height: 146rpx;
  border-radius: 32rpx;
  background: #1252d3;
  box-shadow: 0 26rpx 48rpx rgba(18, 82, 211, 0.2);
}

.robot-antenna {
  position: absolute;
  top: 38rpx;
  width: 22rpx;
  height: 16rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #ffffff;
}

.robot-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  width: 58rpx;
  height: 46rpx;
  border: 10rpx solid #ffffff;
  border-radius: 10rpx;
}

.robot-eye {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}

.robot-mouth {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 8rpx;
  height: 8rpx;
  border-radius: 6rpx;
  background: #ffffff;
}

.robot-ear {
  position: absolute;
  top: 62rpx;
  width: 18rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.robot-ear.left {
  left: 32rpx;
}

.robot-ear.right {
  right: 32rpx;
}

.brand-title {
  margin-top: 34rpx;
  color: #0f55d8;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 900;
}

.brand-subtitle {
  margin-top: 18rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.3;
}

.auth-shell {
  width: 100%;
  box-sizing: border-box;
}

.mode-switch {
  display: flex;
  align-items: center;
  gap: 0;
  width: 100%;
  min-height: 94rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #dce8fb;
}

.mode-item {
  flex: 1;
  text-align: center;
  min-width: 0;
  padding: 24rpx 8rpx;
  border-radius: 18rpx;
  color: #344054;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
}

.mode-item.active {
  color: #0f55d8;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.login-panel {
  margin-top: 44rpx;
  padding: 62rpx 62rpx 56rpx;
  border: 1rpx solid #e5e9f2;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 58rpx rgba(15, 23, 42, 0.06);
}

.panel-title {
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #0f172a;
}

.panel-copy, .bind-copy {
  margin-top: 24rpx;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 800;
}

.login-input {
  height: 96rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #d9e2ec;
  padding: 0 26rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.login-button,
.secondary-button,
.primary-outline-button {
  height: 104rpx;
  margin-top: 58rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.login-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(90deg, #2f6cf5 0%, #1f5ee8 100%);
  color: #ffffff;
  line-height: 1.2;
}

.login-button::after,
.secondary-button::after,
.primary-outline-button::after {
  border: 0;
}

.button-chat-icon {
  width: 42rpx;
  height: 38rpx;
  padding: 6rpx 5rpx;
  box-sizing: border-box;
  border: 4rpx solid #dce8ff;
  border-radius: 4rpx;
}

.button-chat-line {
  height: 3rpx;
  margin-top: 4rpx;
  border-radius: 3rpx;
  background: #dce8ff;
}

.button-chat-line:first-child {
  margin-top: 0;
}

.button-chat-line.short {
  width: 16rpx;
}

.secondary-button {
  background: #f1f5f9;
  color: #0f172a;
}

.primary-outline-button {
  background: #ffffff;
  color: #155eef;
  border: 1rpx solid #bfd3ff;
}

.bind-panel {
  margin-top: 38rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #e5e7eb;
}

.bind-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
}

.wechat-disabled {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #b54708;
  font-size: 24rpx;
  line-height: 1.5;
}

.bind-card {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.switch-link {
  padding-top: 26rpx;
  text-align: center;
  color: #155eef;
  font-size: 26rpx;
  font-weight: 700;
}

.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  margin-top: 58rpx;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.6;
}

.agreement-check {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.agreement-check checkbox {
  transform: scale(0.86);
}

.agreement-link {
  color: #155eef;
  font-weight: 700;
}

.agreement-text {
  color: #667085;
}

.login-footer {
  margin-top: auto;
  padding-top: 96rpx;
  text-align: center;
  color: #98a2b3;
  font-size: 24rpx;
  line-height: 1.4;
}
